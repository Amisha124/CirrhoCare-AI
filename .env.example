# CirrhoCare AI - Production & Development Environment Configuration
# Copy this file to .env and configure the values for your deployment environment.

# Flask Environment ('development' or 'production')
FLASK_CONFIG=production

# Strong random secret key for session cookies and CSRF protection
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars

# Database connection URL (e.g., PostgreSQL in production or SQLite locally)
# Production PostgreSQL example: postgresql://user:password@hostname:5432/cirrhocare
DATABASE_URL=sqlite:///instance/cirrhosis.db

# Enable Demo Mode ('true' or 'false'). Keep 'false' for production patient data isolation.
DEMO_MODE=false

# HTTPS Session Cookie Security (set to 'true' in production with HTTPS)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

# Production Base URL
APP_BASE_URL=https://cirrhocare-ai.onrender.com

# Port configuration (set automatically by hosting environments like Render)
PORT=5000

# Optional: Transactional Email Providers for Activation & Notifications
EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=CirrhoCare AI <onboarding@resend.dev>
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@cirrhocare.ai

